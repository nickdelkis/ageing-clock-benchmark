# Copy to .env (never committed) and fill in ONE of the options below.
# Then restart with: docker compose down && docker compose up

# Option 1: Anthropic (Claude)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5          # default if left unset

# Option 2: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_MODEL=                           # required: a current model with tool calling

# Option 3: local model via Ollama (or any OpenAI-compatible server) running on this computer
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=                           # required: a pulled model that supports tool calling

# ---- Mendelian randomisation (mr service) ----
# Free token from https://api.opengwas.io (sign in, then Profile -> generate token)
OPENGWAS_JWT=
